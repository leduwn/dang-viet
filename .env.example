# Dáng Việt - Environment Configuration
# Không điền API key thật vào tệp này. Sao chép thành .env để dùng cục bộ.

# Server configuration
PORT=3088
HOST=127.0.0.1
DATABASE_PATH=./data/dangviet.db

# 9router / OpenAI-compatible AI Provider (Text / Chat / Structured Design)
# Để trống AI_API_KEY để chạy ở chế độ Mock Adapter an toàn
AI_BASE_URL=https://api.9router.com/v1
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=30000

# 9router AI Image Generation Provider (2D Ao Dai Illustration)
# Nếu để trống AI_IMAGE_API_KEY, hệ thống tự động kế thừa AI_API_KEY
AI_IMAGE_BASE_URL=https://9router.duwn.id.vn/v1
AI_IMAGE_MODEL=ag/gemini-3.1-flash-image
AI_IMAGE_API_KEY=
AI_IMAGE_TIMEOUT_MS=120000

# Client proxy / target
VITE_API_URL=http://127.0.0.1:3088
