# Dáng Việt - Environment Configuration
# Không điền API key thật vào tệp này. Sao chép thành .env để dùng cục bộ.

# Server configuration
PORT=3088
HOST=127.0.0.1
DATABASE_PATH=./data/dangviet.db

# 9router / OpenAI-compatible AI Provider
# Để trống AI_API_KEY để chạy ở chế độ Mock Adapter an toàn
AI_BASE_URL=https://api.9router.com/v1
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=30000

# Client proxy / target
VITE_API_URL=http://127.0.0.1:3088
